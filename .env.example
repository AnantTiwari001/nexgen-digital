# Copy to .env and fill in. Everything is optional for local development.

# Canonical site URL (used for sitemap, Open Graph, canonical links)
PUBLIC_SITE_URL=https://nexgendigital.com.np

# Analytics (leave blank to disable)
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_META_PIXEL_ID=

# Gmail API sending. Create an OAuth 2.0 client (Desktop or Web) in Google Cloud,
# enable the Gmail API, then obtain a refresh token for the sending account with the
# https://www.googleapis.com/auth/gmail.send scope. See docs/EMAIL.md.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# The Gmail address that sends the notifications
GMAIL_SENDER=hello@nexgendigital.com.np
# Where lead / pre-order / chat notifications are delivered
NOTIFY_EMAIL=hello@nexgendigital.com.np

# Storage (Supabase — free tier). Every contact enquiry, pre-order and chat lead is
# saved here; without these set, submissions only print to the server console.
# 1. Create a free project at https://supabase.com
# 2. Project Settings > API — copy "Project URL" and the "service_role" secret key
#    (NOT the anon/public key — the service role key is required to bypass RLS from
#    the server; never expose it to the browser).
# 3. Open the SQL Editor and run supabase/schema.sql once to create the tables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
