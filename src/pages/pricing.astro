---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PricingCard from '../components/PricingCard.astro';
import Icon from '../components/Icon.astro';
import T from '../components/T.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import Ridge from '../components/home/Ridge.astro';
import kathmanduSunset from '../assets/kathmandu/kathmandu-valley-sunset.jpg';
import { categories, services } from '../data/services';
import { product } from '../data/product';
import { t } from '../i18n';

const bundles = [
  { name: 'Launch Bundle', price: '35,000', period: '/month', features: ['Social Media Management · Growth', 'Meta Ads · Starter', '4 AI reels per month', 'Monthly strategy call'], note: 'Save Rs. 10,000 vs separate', highlight: true },
  { name: 'Local Business Bundle', price: '18,000', period: '/month', features: ['Social Media Management · Starter', 'Google Ads · Local', 'Smart Reviews QR stand included', 'Review response management'], note: 'Ideal for cafés, clinics, salons' },
  { name: 'Brand Bundle', price: '85,000', period: 'one-time', features: ['Brand Kit', 'Business website', '10 social creatives', '2 promo videos'], note: 'Everything to launch a brand' },
];
// One tab per service, grouped by category. The QR stand's tab uses the product's own
// tiers so its buttons go straight to pre-order.
const groups = categories
  .map((c) => ({ ...c, items: services.filter((s) => s.category === c.id) }))
  .filter((g) => g.items.length);
const tiersFor = (slug: string) =>
  slug === product.slug
    ? product.tiers.map((tier) => ({
        tier: { ...tier, cta: tier.price === 'Custom' ? 'Talk to us' : 'Pre-order' },
        href: tier.price === 'Custom' ? '/contact' : `/preorder?plan=${encodeURIComponent(tier.name)}`,
      }))
    : (services.find((s) => s.slug === slug)?.pricing ?? []).map((tier) => ({ tier, href: undefined }));
const first = groups[0].items[0].slug;

const faqs = [
  { q: 'Are these final prices?', a: 'They are starting points. After a short call we send a fixed quote based on your scope, and that quote is what you pay.' },
  { q: 'Is there a contract?', a: 'Monthly services run month to month. We ask for a minimum of three months for social media and ads because results take time to compound.' },
  { q: 'How do I pay?', a: 'Bank transfer, eSewa, Khalti or cash. International clients can pay by card.' },
  { q: 'Is VAT included?', a: 'Prices shown exclude VAT. A VAT invoice is provided on request.' },
];
---

<Base title="Pricing" description="Transparent starting prices for digital marketing in Nepal: social media, ads, AI video and graphics, websites, and the Smart Reviews QR stand." headerTone="white">
  <PageHero eyebrow={t('pricing.eyebrow')} eyebrowKey="pricing.eyebrow" title={t('pricing.title')} titleKey="pricing.title" lead={t('pricing.lead')} leadKey="pricing.lead" align="center" script="Same Dreams. Bigger Possibilities." />

  <section class="section">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow">Bundles</p>
        <h2>Combine services and save</h2>
        <p class="lead mx-auto">Our most requested combinations, priced as one plan.</p>
      </div>
      <div class="grid grid--3 bundles" data-reveal-group>
        {bundles.map((b, i) => <PricingCard tier={b} context={b.name} index={i} />)}
      </div>
    </div>
  </section>

  <section class="section section--muted has-ridge price-tabs" id="by-service">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow">By service</p>
        <h2>Pick a service, see its plans</h2>
        <p class="lead mx-auto">Three plans for every service. Start small and move up when it's working.</p>
      </div>

      <div class="price-tabs__bar" role="tablist" aria-label="Services" data-price-tabs>
        {groups.map((g) => (
          <div class="price-tabs__group" id={g.id}>
            <p class="price-tabs__cat"><Icon name={g.icon} size={14} /><span data-i18n={`cat.${g.id}.name`}>{g.name}</span></p>
            <div class="price-tabs__chips">
              {g.items.map((s) => (
                <button type="button" role="tab" class="price-tabs__chip" id={`tab-${s.slug}`} aria-controls={`panel-${s.slug}`} aria-selected={s.slug === first ? 'true' : 'false'} tabindex={s.slug === first ? 0 : -1} data-slug={s.slug}>
                  <span data-i18n={`svc.${s.slug}.name`}>{s.shortName ?? s.name}</span>
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>

      {groups.flatMap((g) => g.items).map((s) => (
        <div class="price-tabs__panel" role="tabpanel" id={`panel-${s.slug}`} aria-labelledby={`tab-${s.slug}`} hidden={s.slug !== first} data-price-panel={s.slug}>
          <div class="price-tabs__head">
            <div>
              <h3 data-i18n={`svc.${s.slug}.name`}>{s.name}</h3>
              <p class="muted">{s.tagline}</p>
            </div>
            <a class="price-tabs__more" href={s.href ?? `/services/${s.slug}`}><T k="services.learnMore" /><Icon name="arrow" size={16} /></a>
          </div>
          <div class="grid grid--3 price-tabs__grid">
            {tiersFor(s.slug).map(({ tier, href }, i) => <PricingCard tier={tier} context={s.name} href={href} index={i} />)}
          </div>
        </div>
      ))}
      <noscript><style is:inline>[data-price-panel][hidden] { display: block !important; margin-top: 4rem; }</style></noscript>
    </div>
    <Ridge to="var(--dusk-sky-top)" />
  </section>

  <section class="section has-ridge pricing-dusk" data-parallax-scope data-trace-band>
    <Image class="pricing-dusk__photo" src={kathmanduSunset} alt="The Himalayas at sunset, seen from the Kathmandu valley" width={1800} height={950} quality={78} data-parallax="0.08" />
    <div class="pricing-dusk__wash" aria-hidden="true"></div>
    <div class="container pricing-dusk__inner">
      <svg class="trace-svg band-trace" viewBox="0 0 260 90" aria-hidden="true">
        <path class="trace-path" data-trace-path d="M14,70 C 60,20 120,80 150,30 S 220,15 246,18" />
      </svg>
      <div class="spark-wrap" data-trace-sparks style="left:50%; top:8%;"></div>
      <p class="caps pricing-dusk__eyebrow" data-reveal><Icon name="sun" size={14} /> No hidden costs</p>
      <h2 class="pricing-dusk__headline" data-split>Real prices for real Nepali businesses</h2>
      <p class="lead pricing-dusk__lead" data-reveal style="--reveal-delay:150ms">
        Every number on this page is a starting point we'll turn into a fixed quote — not a teaser rate that changes once you sign.
      </p>
    </div>
    <Ridge to="var(--bg-muted)" flip />
  </section>

  <section class="section section--muted has-ridge">
    <div class="container container--narrow">
      <div class="section-head section-head--center" data-reveal><h2><T k="services.faq" /></h2></div>
      <FaqList items={faqs} />
    </div>
    <Ridge to="var(--dusk-sky-top)" />
  </section>

  <CtaBand />
</Base>

<style>
  .bundles { padding-top: var(--space-4); align-items: stretch; }
  /* Services as tabs: chips grouped under their category, one panel of plans at a time. */
  .price-tabs__bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    justify-content: center;
    margin-bottom: var(--space-7);
  }
  .price-tabs__group { display: grid; gap: var(--space-2); scroll-margin-top: calc(var(--header-h) + var(--space-4)); }
  .price-tabs__cat {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
  .price-tabs__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .price-tabs__chip {
    padding: 0.6em 1.1em;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--line-strong);
    background: var(--bg-elev);
    color: var(--fg);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-sm);
    transition: background-color var(--dur-fast), border-color var(--dur-fast), color var(--dur-fast);
  }
  .price-tabs__chip:hover { border-color: var(--accent); color: var(--accent); }
  .price-tabs__chip[aria-selected='true'] { background: var(--accent); border-color: var(--accent); color: #fff; }
  .price-tabs__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .price-tabs__head h3 { margin: 0 0 var(--space-1); }
  .price-tabs__head p { margin: 0; }
  .price-tabs__more { display: inline-flex; align-items: center; gap: 0.4em; font-family: var(--font-heading); font-weight: 700; color: var(--accent); }
  .price-tabs__grid { align-items: stretch; padding-top: var(--space-3); }
  .price-tabs__panel { animation: price-panel-in 0.4s var(--ease-out); }
  @keyframes price-panel-in {
    from { opacity: 0; transform: translateY(10px); }
  }
  @media (prefers-reduced-motion: reduce) { .price-tabs__panel { animation: none; } }

  /* Same full-bleed photo + dusk-gradient wash pattern as About, the product
     page's audience section, and the services index closing band. */
  .pricing-dusk {
    position: relative;
    overflow: hidden;
    text-align: center;
    background: var(--dusk-gradient);
    color: var(--dusk-fg);
  }
  .pricing-dusk :global(.pricing-dusk__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pricing-dusk__wash {
    position: absolute;
    inset: 0;
    background: var(--dusk-gradient);
    opacity: 0.78;
    mix-blend-mode: multiply;
  }
  .pricing-dusk__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }
  .pricing-dusk__eyebrow { display: inline-flex; align-items: center; gap: 0.5em; color: var(--dusk-fg); opacity: 0.85; }
  .pricing-dusk__headline { margin: 0; color: var(--dusk-fg); font-size: var(--text-4xl); }
  .pricing-dusk__headline :global(.word) { display: inline-block; }
  .pricing-dusk__lead { margin: 0; color: var(--dusk-fg-muted); max-width: 62ch; }
  .band-trace {
    position: absolute;
    top: -6%;
    left: 50%;
    width: min(340px, 70%);
    transform: translateX(-50%);
    color: var(--brand-gold);
    z-index: 1;
  }
</style>

<script>
  import { initTraceBands } from '../scripts/trace';
  initTraceBands();

  // Service tabs: click or arrow keys switch the panel; #slug (or a category id) in the URL
  // opens that service, so links like /pricing#meta-ads land on the right plans.
  const bar = document.querySelector<HTMLElement>('[data-price-tabs]');
  if (bar) {
    const tabs = Array.from(bar.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(`panel-${t.dataset.slug}`)!.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        select(tab);
        history.replaceState(null, '', `#${tab.dataset.slug}`);
      });
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        select(tabs[(i + step + tabs.length) % tabs.length], true);
      });
    });
    const fromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id) return;
      const tab = tabs.find((t) => t.dataset.slug === id) ?? document.getElementById(id)?.querySelector<HTMLButtonElement>('[role="tab"]');
      if (!tab) return;
      select(tab);
      document.getElementById('by-service')?.scrollIntoView({ block: 'start' });
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);
  }
</script>
