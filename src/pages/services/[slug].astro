---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import T from '../../components/T.astro';
import SectionHead from '../../components/SectionHead.astro';
import PricingCard from '../../components/PricingCard.astro';
import FaqList from '../../components/FaqList.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import WorkPiece from '../../components/WorkPiece.astro';
import MediaSlot from '../../components/MediaSlot.astro';
import ResultCard from '../../components/ResultCard.astro';
import StoryFeature from '../../components/StoryFeature.astro';
import Ridge from '../../components/home/Ridge.astro';
import Process from '../../components/sections/Process.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import BeforeAfterReveal from '../../components/sections/BeforeAfterReveal.astro';
import VideoScrubDemo from '../../components/sections/VideoScrubDemo.astro';
import patanSquare from '../../assets/kathmandu/patan-durbar-square.jpg';
import { categories, getService, servicePages } from '../../data/services';
import { testimonialForService } from '../../data/testimonials';
import { work } from '../../data/work';
import { site, whatsappUrl } from '../../config/site';
import { t } from '../../i18n';

export const getStaticPaths: GetStaticPaths = () => servicePages.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));

const { service } = Astro.props;
const category = categories.find((c) => c.id === service.category)!;
const related = service.related.map((r) => getService(r)!).filter(Boolean);
const wa = whatsappUrl(`Hi NexGen Digital, I am interested in ${service.name}.`);
const testimonial = testimonialForService(service.name);
const sample = work.find((w) => w.service === service.slug);
// "3.1x more weekly engagement in 60 days" -> metric "3.1×", label "more weekly engagement in 60 days".
// Results that don't lead with a number keep the whole sentence as the label.
const splitStat = (stat: string) => {
  const m = stat.match(/^([\d.,]+\s?[x%]?\+?)\s+(.+)$/i);
  return m ? { metric: m[1].replace(/x$/i, '×'), label: m[2] } : { metric: undefined, label: stat };
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.summary,
  serviceType: category.name,
  provider: { '@type': 'Organization', name: site.name },
  areaServed: 'Nepal',
  offers: service.pricing
    .filter((p) => /^\d/.test(p.price))
    .map((p) => ({ '@type': 'Offer', name: p.name, price: p.price.replace(/,/g, ''), priceCurrency: 'NPR' })),
};
---

<Base title={service.seo.title} description={service.seo.description} headerTone="white" jsonLd={[serviceLd]}>
  <PageHero script={service.accentPhrase} echo={service.nepaliLine}>
    <a slot="eyebrow" href={`/services#${category.id}`} data-i18n={`cat.${category.id}.name`}>{category.name}</a>
    <span slot="title" data-i18n={`svc.${service.slug}.name`}>{service.name}</span>
    <span slot="lead" data-i18n={`svc.${service.slug}.tagline`}>{service.tagline}</span>
    <div class="svc-hero__btns">
      <a class="btn btn--white btn--lg" href={wa} target="_blank" rel="noopener" data-magnetic><Icon name="whatsapp" size={20} /><T k="cta.whatsapp" /></a>
      <a class="svc-hero__link" href="#pricing"><T k="services.pricing" /><Icon name="arrow" size={18} class="svc-hero__down" /></a>
    </div>
    <div slot="visual" class="svc-hero__visual">
      {sample ? (
        <WorkPiece item={sample} />
      ) : (
        <div class="svc-hero__frame">
          <MediaSlot ratio="4 / 5" label={`${service.shortName ?? service.name} work sample`} spec="4:5 · client piece" tone="orange" />
          <span class="svc-hero__badge"><Icon name={service.icon} size={28} /></span>
        </div>
      )}
    </div>
  </PageHero>

  <section class="section">
    <div class="container svc-intro">
      <div data-reveal="left">
        <p class="eyebrow"><T k="services.problem" /></p>
        <h2>{service.problem.title}</h2>
        <p class="lead">{service.problem.text}</p>
      </div>
      <div class="card card--black svc-intro__summary" data-reveal="right">
        <Icon name="quote" size={36} class="svc-intro__q" />
        <p>{service.summary}</p>
        <span class="script">{service.accentPhrase}</span>
      </div>
    </div>
  </section>

  {service.beforeAfter && <BeforeAfterReveal data={service.beforeAfter} />}
  {service.videoDemo && <VideoScrubDemo data={service.videoDemo} />}

  <section class="section section--muted svc-get">
    <div class="container">
      <SectionHead eyebrow="services.whatYouGet">
        <span slot="title">{service.tagline}</span>
      </SectionHead>
      <div class="svc-benefits" data-reveal-group>
        {service.benefits.map((b) => (
          <div class="card card--hover svc-benefit" data-reveal>
            <span class="icon-tile"><Icon name={b.icon ?? 'check'} /></span>
            <div>
              <h3>{b.title}</h3>
              <p class="muted">{b.text}</p>
            </div>
          </div>
        ))}
      </div>
      <ul class="svc-deliverables" data-reveal-group>
        {service.deliverables.map((d) => (
          <li data-reveal><Icon name="check" size={18} /> {d}</li>
        ))}
      </ul>
    </div>
    <Ridge to="var(--dusk-sky-top)" />
  </section>

  <section class="band-dusk svc-results">
    <div class="container">
      <div class="band-dusk__head" data-reveal>
        <p class="eyebrow"><T k="services.examples" /></p>
        <h2>Recent {service.shortName ?? service.name} results</h2>
        <T k="services.examplesLead" as="p" class="lead" />
      </div>
      <div class="band-dusk__grid" data-reveal-group>
        {service.examples.map((ex) => {
          const { metric, label } = splitStat(ex.stat);
          return <ResultCard media={false} metric={metric} metricLabel={label} client={ex.title} meta={ex.tag} summary={ex.description} placeholder={ex.placeholder} />;
        })}
      </div>
    </div>
    <Ridge to="var(--surface-ink)" flip />
  </section>

  <Process steps={service.process} />

  <section class="section svc-why">
    <div class="container svc-why__grid">
      <SectionHead eyebrow="services.whyUs">
        <span slot="title">Why choose NexGen for <span class="hl">{service.name}</span></span>
        <span slot="lead">{service.whyUs.lead}</span>
      </SectionHead>
      <ul class="svc-why__list" data-reveal-group>
        {service.whyUs.points.map((p) => (
          <li class="svc-why__point" data-reveal>
            <span class="icon-tile"><Icon name="check" size={20} /></span>
            <div>
              <h3>{p.title}</h3>
              <p class="muted">{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {testimonial && (
    <section class="section section--muted svc-testimonial">
      <div class="container">
        <SectionHead eyebrow="services.testimonial">
          <span slot="title">What clients say about <span class="hl">{service.name}</span></span>
        </SectionHead>
        <StoryFeature item={testimonial} />
      </div>
    </section>
  )}

  <section class="section" id="pricing">
    <div class="container">
      <SectionHead eyebrow="services.pricing" lead="services.pricingNote" align="center">
        <span slot="title" data-i18n={`svc.${service.slug}.name`}>{service.name}</span>
      </SectionHead>
      <div class="grid grid--3 svc-pricing" data-reveal-group>
        {service.pricing.map((tier, i) => (
          <PricingCard tier={tier} context={service.name} index={i} />
        ))}
      </div>
    </div>
  </section>

  {service.faqs.length > 0 && (
    <section class="section section--muted">
      <div class="container container--narrow">
        <SectionHead eyebrow="services.faq" align="center">
          <span slot="title"><T k="services.faq" /></span>
        </SectionHead>
        <FaqList items={service.faqs} />
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHead eyebrow="services.related">
          <span slot="title"><T k="services.related" /></span>
        </SectionHead>
        <div class="grid grid--3" data-reveal-group>
          {related.map((r, i) => (
            <ServiceCard service={r} index={i} variant="compact" />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section svc-local" data-parallax-scope data-trace-band>
    <Image class="svc-local__photo" src={patanSquare} alt="A courtyard temple in Patan Durbar Square, Kathmandu" width={1800} height={950} quality={78} data-parallax="0.08" />
    <div class="svc-local__wash" aria-hidden="true"></div>
    <div class="container svc-local__inner">
      <svg class="trace-svg band-trace" viewBox="0 0 260 90" aria-hidden="true">
        <path class="trace-path" data-trace-path d="M14,70 C 60,20 120,80 150,30 S 220,15 246,18" />
      </svg>
      <div class="spark-wrap" data-trace-sparks style="left:50%; top:8%;"></div>
      <p class="caps svc-local__eyebrow" data-reveal><Icon name="pin" size={14} /> {site.location.city}, {site.location.country}</p>
      <h2 class="svc-local__headline" data-split>{service.name}, run by people who live here</h2>
      <p class="lead svc-local__lead" data-reveal style="--reveal-delay:150ms">
        Every {service.shortName ?? service.name} campaign we run is shaped by a team based in Kathmandu — not a template applied from somewhere else.
      </p>
    </div>
  </section>

  <CtaBand titleKey="services.cta.title" textKey="services.cta.text" whatsappMessage={`Hi NexGen Digital, I am interested in ${service.name}.`} />
</Base>

<style>
  .svc-hero__btns { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); margin-top: var(--space-5); }
  .svc-hero__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-heading);
    font-weight: 700;
    border-bottom: 2px solid rgba(255, 255, 255, 0.5);
    padding-bottom: 2px;
  }
  .svc-hero__link:hover { border-color: #fff; }
  .svc-hero__link :global(.svc-hero__down) { transform: rotate(90deg); }
  .svc-hero__visual { --h: clamp(320px, 42vw, 440px); --piece-result: #fff3d6; color: #fff; display: grid; justify-items: center; }
  .svc-hero__frame {
    position: relative;
    width: min(320px, 80vw);
    padding: 8px;
    background: #fff;
    border-radius: calc(var(--radius-lg) + 6px);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.28);
    transform: rotate(-3deg);
  }
  .svc-hero__frame :global(.slot) { border-radius: var(--radius-lg); }
  .svc-hero__badge {
    position: absolute;
    right: -18px;
    bottom: 28px;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--brand-black);
    color: #fff;
    box-shadow: 0 16px 30px rgba(0, 0, 0, 0.3);
  }
  .svc-benefits { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
  @media (min-width: 720px) { .svc-benefits { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .svc-get { padding-bottom: calc(var(--section-y) + clamp(44px, 7vw, 120px)); }
  .svc-results { padding-bottom: calc(var(--section-y) + clamp(44px, 7vw, 120px)); }
  .svc-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    align-items: center;
  }
  @media (min-width: 900px) {
    .svc-intro { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
  }
  .svc-intro__summary {
    position: relative;
    padding: var(--space-7);
    font-size: var(--text-lg);
  }
  .svc-intro__summary :global(.svc-intro__q) { color: var(--brand-orange); margin-bottom: var(--space-4); }
  .svc-intro__summary .script { font-size: var(--text-2xl); }
  .svc-benefit {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .svc-benefit h3 { font-size: var(--text-lg); margin-bottom: var(--space-2); }
  .svc-benefit p { margin: 0; font-size: var(--text-sm); }
  .svc-deliverables {
    list-style: none;
    padding: 0;
    margin: var(--space-7) 0 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }
  .svc-deliverables li {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    padding: var(--space-3) var(--space-4);
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    font-weight: 500;
  }
  .svc-deliverables svg { color: var(--accent); flex: none; }
  .svc-pricing { align-items: stretch; padding-top: var(--space-4); }

  /* ---- Why choose NexGen ---- */
  .svc-why__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }
  @media (min-width: 900px) {
    .svc-why__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
  }
  .svc-why__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  .svc-why__point {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .svc-why__point h3 { font-size: var(--text-lg); margin-bottom: var(--space-2); }
  .svc-why__point p { margin: 0; font-size: var(--text-sm); }

  /* Full-bleed photo + dusk-gradient wash — same pattern as About, the product
     page's audience section, and the services index/pricing closing bands. */
  .svc-local {
    position: relative;
    overflow: hidden;
    text-align: center;
    background: var(--dusk-gradient);
    color: var(--dusk-fg);
  }
  .svc-local :global(.svc-local__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .svc-local__wash {
    position: absolute;
    inset: 0;
    background: var(--dusk-gradient);
    opacity: 0.78;
    mix-blend-mode: multiply;
  }
  .svc-local__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }
  .svc-local__eyebrow { display: inline-flex; align-items: center; gap: 0.5em; color: var(--dusk-fg); opacity: 0.85; }
  .svc-local__headline { margin: 0; color: var(--dusk-fg); font-size: var(--text-4xl); }
  .svc-local__headline :global(.word) { display: inline-block; }
  .svc-local__lead { margin: 0; color: var(--dusk-fg-muted); max-width: 62ch; }
  .band-trace {
    position: absolute;
    top: -6%;
    left: 50%;
    width: min(340px, 70%);
    transform: translateX(-50%);
    color: var(--brand-gold);
    z-index: 1;
  }
</style>

<script>
  import { initTraceBands } from '../../scripts/trace';
  initTraceBands();
</script>
