---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import T from '../../components/T.astro';
import SectionHead from '../../components/SectionHead.astro';
import PricingCard from '../../components/PricingCard.astro';
import FaqList from '../../components/FaqList.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Process from '../../components/sections/Process.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import BeforeAfterReveal from '../../components/sections/BeforeAfterReveal.astro';
import VideoScrubDemo from '../../components/sections/VideoScrubDemo.astro';
import { categories, getService, servicePages } from '../../data/services';
import { testimonialForService } from '../../data/testimonials';
import { site, whatsappUrl } from '../../config/site';
import { t } from '../../i18n';

export const getStaticPaths: GetStaticPaths = () => servicePages.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));

const { service } = Astro.props;
const category = categories.find((c) => c.id === service.category)!;
const related = service.related.map((r) => getService(r)!).filter(Boolean);
const wa = whatsappUrl(`Hi NexGen Digital, I am interested in ${service.name}.`);
const testimonial = testimonialForService(service.name);
const initials = (name: string) =>
  name
    .split(' ')
    .map((n) => n[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.summary,
  serviceType: category.name,
  provider: { '@type': 'Organization', name: site.name },
  areaServed: 'Nepal',
  offers: service.pricing
    .filter((p) => /^\d/.test(p.price))
    .map((p) => ({ '@type': 'Offer', name: p.name, price: p.price.replace(/,/g, ''), priceCurrency: 'NPR' })),
};
---

<Base title={service.seo.title} description={service.seo.description} headerTone="white" jsonLd={[serviceLd]}>
  <PageHero script={service.accentPhrase}>
    <p class="eyebrow" slot="eyebrow"><a href={`/services#${category.id}`} data-i18n={`cat.${category.id}.name`}>{category.name}</a></p>
    <span slot="title" data-i18n={`svc.${service.slug}.name`}>{service.name}</span>
    <span slot="lead" data-i18n={`svc.${service.slug}.tagline`}>{service.tagline}</span>
    <div class="btn-row svc-hero__btns">
      <a class="btn btn--white btn--lg" href="/contact" data-magnetic><T k="services.getQuote" /><Icon name="arrow" size={18} class="arrow" /></a>
      <a class="btn btn--outline btn--lg" href="#pricing"><T k="services.pricing" /></a>
      <a class="btn btn--whatsapp btn--lg" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} />WhatsApp</a>
    </div>
    {service.nepaliLine && <p class="ne svc-hero__ne">{service.nepaliLine}</p>}
    <div slot="visual" class="svc-hero__icon" data-float="14">
      <Icon name={service.icon} size={140} />
    </div>
  </PageHero>

  <section class="section">
    <div class="container svc-intro">
      <div data-reveal="left">
        <p class="eyebrow"><T k="services.problem" /></p>
        <h2>{service.problem.title}</h2>
        <p class="lead">{service.problem.text}</p>
      </div>
      <div class="card card--black svc-intro__summary" data-reveal="right">
        <Icon name="quote" size={36} class="svc-intro__q" />
        <p>{service.summary}</p>
        <span class="script">{service.accentPhrase}</span>
      </div>
    </div>
  </section>

  {service.beforeAfter && <BeforeAfterReveal data={service.beforeAfter} />}
  {service.videoDemo && <VideoScrubDemo data={service.videoDemo} />}

  <section class="section section--muted">
    <div class="container">
      <SectionHead eyebrow="services.whatYouGet">
        <span slot="title">{service.tagline}</span>
      </SectionHead>
      <div class="grid grid--2 svc-benefits" data-reveal-group>
        {service.benefits.map((b) => (
          <div class="card card--hover svc-benefit" data-reveal>
            <span class="icon-tile"><Icon name={b.icon ?? 'check'} /></span>
            <div>
              <h3>{b.title}</h3>
              <p class="muted">{b.text}</p>
            </div>
          </div>
        ))}
      </div>
      <ul class="svc-deliverables" data-reveal-group>
        {service.deliverables.map((d) => (
          <li data-reveal><Icon name="check" size={18} /> {d}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--soft svc-examples">
    <div class="container">
      <SectionHead eyebrow="services.examples" lead="services.examplesLead">
        <span slot="title">Recent {service.shortName ?? service.name} results</span>
      </SectionHead>
    </div>
    <div class="svc-examples__scroller" data-reveal>
      <div class="svc-examples__track container">
        {service.examples.map((ex, i) => (
          <article class="ex-card card card--hover" data-tilt="6" style={`--i:${i}`}>
            <span class="ex-card__badge caps">Sample result</span>
            <span class="pill pill--soft">{ex.tag}</span>
            <p class="ex-card__stat">{ex.stat}</p>
            <h3 class="ex-card__title">{ex.title}</h3>
            <p class="ex-card__desc muted">{ex.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Process steps={service.process} />

  <section class="section svc-why">
    <div class="container svc-why__grid">
      <SectionHead eyebrow="services.whyUs">
        <span slot="title">Why choose NexGen for <span class="hl">{service.name}</span></span>
        <span slot="lead">{service.whyUs.lead}</span>
      </SectionHead>
      <ul class="svc-why__list" data-reveal-group>
        {service.whyUs.points.map((p) => (
          <li class="svc-why__point" data-reveal>
            <span class="icon-tile"><Icon name="check" size={20} /></span>
            <div>
              <h3>{p.title}</h3>
              <p class="muted">{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {testimonial && (
    <section class="section section--muted svc-testimonial">
      <div class="container container--narrow">
        <SectionHead eyebrow="services.testimonial" align="center">
          <span slot="title">What clients say about <span class="hl">{service.name}</span></span>
        </SectionHead>
        <article class="tspot card" data-reveal="scale">
          <Icon name="quote" size={36} class="tspot__quote" />
          <div class="tspot__stars" aria-label={`${testimonial.rating} out of 5 stars`}>
            {Array.from({ length: testimonial.rating }).map(() => <Icon name="star" size={16} />)}
          </div>
          <p class="tspot__text">“{testimonial.quote}”</p>
          <footer class="tspot__foot">
            <span class="tspot__avatar">{testimonial.avatar ? <img src={testimonial.avatar} alt="" /> : initials(testimonial.business)}</span>
            <span>
              <strong>{testimonial.name}</strong>, {testimonial.role}<br />
              <span class="small muted">{testimonial.business} · {testimonial.location}</span>
            </span>
          </footer>
          {testimonial.placeholder && <p class="small muted tspot__note"><T k="testimonials.placeholder" /></p>}
        </article>
      </div>
    </section>
  )}

  <section class="section" id="pricing">
    <div class="container">
      <SectionHead eyebrow="services.pricing" lead="services.pricingNote" align="center">
        <span slot="title"><span data-i18n={`svc.${service.slug}.name`}>{service.name}</span> · <T k="pricing.title" /></span>
      </SectionHead>
      <div class="grid grid--3 svc-pricing" data-reveal-group>
        {service.pricing.map((tier, i) => (
          <PricingCard tier={tier} context={service.name} index={i} />
        ))}
      </div>
    </div>
  </section>

  {service.faqs.length > 0 && (
    <section class="section section--muted">
      <div class="container container--narrow">
        <SectionHead eyebrow="services.faq" align="center">
          <span slot="title"><T k="services.faq" /></span>
        </SectionHead>
        <FaqList items={service.faqs} />
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHead eyebrow="services.related">
          <span slot="title"><T k="services.related" /></span>
        </SectionHead>
        <div class="grid grid--3" data-reveal-group>
          {related.map((r, i) => (
            <ServiceCard service={r} index={i} variant="compact" />
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand titleKey="services.cta.title" textKey="services.cta.text" whatsappMessage={`Hi NexGen Digital, I am interested in ${service.name}.`} />
</Base>

<style>
  .svc-hero__btns { margin-top: var(--space-5); }
  .svc-hero__ne { margin-top: var(--space-5); font-size: var(--text-lg); opacity: 0.92; }
  .svc-hero__icon {
    display: grid;
    place-items: center;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(10px);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.25);
  }
  .svc-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    align-items: center;
  }
  @media (min-width: 900px) {
    .svc-intro { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
  }
  .svc-intro__summary {
    position: relative;
    padding: var(--space-7);
    font-size: var(--text-lg);
  }
  .svc-intro__summary :global(.svc-intro__q) { color: var(--brand-orange); margin-bottom: var(--space-4); }
  .svc-intro__summary .script { font-size: var(--text-2xl); }
  .svc-benefit {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .svc-benefit h3 { font-size: var(--text-lg); margin-bottom: var(--space-2); }
  .svc-benefit p { margin: 0; font-size: var(--text-sm); }
  .svc-deliverables {
    list-style: none;
    padding: 0;
    margin: var(--space-7) 0 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }
  .svc-deliverables li {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    padding: var(--space-3) var(--space-4);
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    font-weight: 500;
  }
  .svc-deliverables svg { color: var(--accent); flex: none; }
  .svc-pricing { align-items: stretch; padding-top: var(--space-4); }

  /* ---- Example / case-study gallery ---- */
  .svc-examples__scroller {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: var(--space-3);
  }
  .svc-examples__scroller::-webkit-scrollbar { display: none; }
  .svc-examples__track {
    display: flex;
    gap: var(--space-5);
  }
  .ex-card {
    position: relative;
    flex: 0 0 min(84vw, 340px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .ex-card__badge {
    position: absolute;
    top: var(--space-5);
    right: var(--space-6);
    color: var(--fg-subtle);
    font-size: var(--text-xs);
  }
  .ex-card__stat {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: var(--text-2xl);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--accent);
    margin: 0;
  }
  .ex-card__title {
    font-size: var(--text-lg);
    margin: 0;
  }
  .ex-card__desc {
    margin: 0;
    font-size: var(--text-sm);
    flex: 1;
  }

  /* ---- Why choose NexGen ---- */
  .svc-why__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
  }
  @media (min-width: 900px) {
    .svc-why__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
  }
  .svc-why__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  .svc-why__point {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .svc-why__point h3 { font-size: var(--text-lg); margin-bottom: var(--space-2); }
  .svc-why__point p { margin: 0; font-size: var(--text-sm); }

  /* ---- Matching testimonial spotlight ---- */
  .tspot {
    position: relative;
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
    padding: var(--space-8) var(--space-6);
  }
  .tspot :global(.tspot__quote) {
    color: var(--accent-soft);
    margin: 0 auto var(--space-4);
  }
  .tspot__stars {
    display: flex;
    justify-content: center;
    gap: 2px;
    color: #f5a623;
    margin-bottom: var(--space-4);
  }
  .tspot__text {
    font-size: var(--text-xl);
    line-height: 1.5;
    margin: 0 0 var(--space-5);
  }
  .tspot__foot {
    display: inline-flex;
    gap: var(--space-3);
    align-items: center;
    text-align: left;
  }
  .tspot__avatar {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--brand-black);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    flex: none;
    overflow: hidden;
  }
  .tspot__avatar img { width: 100%; height: 100%; object-fit: cover; }
  .tspot__note { margin: var(--space-4) 0 0; }
</style>
