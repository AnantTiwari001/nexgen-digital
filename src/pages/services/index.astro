---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Icon from '../../components/Icon.astro';
import T from '../../components/T.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Marquee from '../../components/sections/Marquee.astro';
import boudhanath from '../../assets/kathmandu/boudhanath.jpg';
import { categories, servicesByCategory } from '../../data/services';
import { t } from '../../i18n';
import { site } from '../../config/site';
---

<Base title="Services" description="Digital marketing services in Nepal: social media management, content, Meta and Google ads, AI video and graphics, websites, strategy and the Smart Reviews QR stand." headerTone="white">
  <PageHero eyebrow={t('services.eyebrow')} eyebrowKey="services.eyebrow" title={t('services.allTitle')} titleKey="services.allTitle" lead={t('services.allLead')} leadKey="services.allLead" script={site.phrases.scriptHero}>
    <nav class="cat-nav" aria-label="Service categories">
      {categories.map((c) => (
        <a href={`#${c.id}`} class="pill pill--glass"><Icon name={c.icon} size={16} /><span data-i18n={`cat.${c.id}.name`}>{c.name}</span></a>
      ))}
    </nav>
  </PageHero>

  <Marquee keys={['marquee.a', 'marquee.c', 'marquee.d']} />

  {categories.map((c, ci) => {
    const list = servicesByCategory(c.id);
    return (
      <section class:list={['section', { 'section--muted': ci % 2 === 1 }]} id={c.id}>
        <div class="container">
          <div class="cat-head" data-reveal>
            <span class="icon-tile"><Icon name={c.icon} /></span>
            <div>
              <h2 class="cat-head__title" data-i18n={`cat.${c.id}.name`}>{c.name}</h2>
              <p class="lead">{c.tagline}</p>
            </div>
          </div>
          <div class="grid grid--3" data-reveal-group>
            {list.map((s, i) => (
              <ServiceCard service={s} index={i} variant={s.slug === 'ai-smart-reviews-qr' ? 'accent' : 'default'} />
            ))}
          </div>
        </div>
      </section>
    );
  })}

  <section class="section svc-local" data-parallax-scope data-trace-band>
    <Image class="svc-local__photo" src={boudhanath} alt="Boudhanath Stupa, Kathmandu" width={1800} height={950} quality={78} data-parallax="0.08" />
    <div class="svc-local__wash" aria-hidden="true"></div>
    <div class="container svc-local__inner">
      <svg class="trace-svg band-trace" viewBox="0 0 260 90" aria-hidden="true">
        <path class="trace-path" data-trace-path d="M14,70 C 60,20 120,80 150,30 S 220,15 246,18" />
      </svg>
      <div class="spark-wrap" data-trace-sparks style="left:50%; top:8%;"></div>
      <p class="caps svc-local__eyebrow" data-reveal><Icon name="pin" size={14} /> {site.location.city}, {site.location.country}</p>
      <h2 class="svc-local__headline" data-split>Built by people who scroll the same feeds you do</h2>
      <p class="lead svc-local__lead" data-reveal style="--reveal-delay:150ms">
        Every service on this page is run by a team that grew up here — not a template applied from somewhere else.
      </p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .cat-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .cat-head {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    margin-bottom: var(--space-6);
  }
  .cat-head__title { margin-bottom: var(--space-1); }
  .cat-head .lead { margin: 0; }

  /* Full-bleed photo + dusk-gradient wash, same pattern as About's golden-hour
     band and the product page's audience section — one visual language, reused
     rather than reinvented per page. */
  .svc-local {
    position: relative;
    overflow: hidden;
    text-align: center;
    background: var(--dusk-gradient);
    color: var(--dusk-fg);
  }
  .svc-local :global(.svc-local__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .svc-local__wash {
    position: absolute;
    inset: 0;
    background: var(--dusk-gradient);
    opacity: 0.78;
    mix-blend-mode: multiply;
  }
  .svc-local__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }
  .svc-local__eyebrow { display: inline-flex; align-items: center; gap: 0.5em; color: var(--dusk-fg); opacity: 0.85; }
  .svc-local__headline { margin: 0; color: var(--dusk-fg); font-size: var(--text-4xl); }
  .svc-local__headline :global(.word) { display: inline-block; }
  .svc-local__lead { margin: 0; color: var(--dusk-fg-muted); max-width: 62ch; }
  .band-trace {
    position: absolute;
    top: -6%;
    left: 50%;
    width: min(340px, 70%);
    transform: translateX(-50%);
    color: var(--brand-gold);
    z-index: 1;
  }
</style>

<script>
  import { initTraceBands } from '../../scripts/trace';
  initTraceBands();
</script>
