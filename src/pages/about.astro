---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import T from '../components/T.astro';
import Logo from '../components/Logo.astro';
import Mountains from '../components/Mountains.astro';
import Stats from '../components/sections/Stats.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import TeamWall from '../components/home/TeamWall.astro';
import Ridge from '../components/home/Ridge.astro';
import boudhanath from '../assets/kathmandu/boudhanath.jpg';
import kathmanduSunset from '../assets/kathmandu/kathmandu-valley-sunset.jpg';
import { story, values, milestones } from '../data/team';
import { site } from '../config/site';
import { t } from '../i18n';


---

<Base title="About" description="NexGen Digital is a Kathmandu-based digital growth agency combining local talent with AI tools to help Nepali businesses, brands and creators grow." headerTone="white">
  <PageHero eyebrow={t('about.eyebrow')} eyebrowKey="about.eyebrow" title={t('about.title')} titleKey="about.title" lead={story.intro} script={site.phrases.scriptHero} tone="black" titleClass="text-gradient-dusk">
    <div slot="visual" class="about-hero__visual">
      <div class="about-hero__card card card--glass" data-float="10">
        <Logo variant="stacked" height={80} tone="white" />
        <p class="caps">{site.phrases.pillars.join(' · ')}</p>
      </div>
    </div>
  </PageHero>

  <section class="section has-ridge">
    <div class="container story">
      <div class="story__text" data-reveal="left">
        <p class="eyebrow"><T k="about.story" /></p>
        <h2>{story.headline}</h2>
        {story.paragraphs.map((p) => <p class="lead">{p}</p>)}
        <p class="script">{site.phrases.partner}</p>
      </div>
      <div class="story__side" data-reveal="right">
        <div class="card story__kathmandu">
          <Image class="story__photo" src={boudhanath} alt="Boudhanath Stupa, Kathmandu" width={640} height={480} quality={80} />
          <div class="story__kathmandu-fade" aria-hidden="true"></div>
          <div class="story__kathmandu-body">
            <Icon name="pin" size={28} />
            <h3><T k="about.kathmandu" /></h3>
            <p>{site.location.addressLine}</p>
            <p class="caps">{site.location.serviceArea}</p>
          </div>
        </div>
        <ol class="milestones">
          {milestones.map((m) => (
            <li><span class="milestones__year">{m.year}</span><span>{m.title}</span></li>
          ))}
        </ol>
      </div>
    </div>
    <Ridge to="var(--brand-orange)" />
  </section>

  <TeamWall link={false} ridgeTo="var(--surface-ink)" />

  <section class="section section--inverse has-ridge values-sec" data-parallax-scope>
    <div class="values-sec__mark" data-parallax="0.12" aria-hidden="true"><Logo variant="mark" height={460} tone="white" /></div>
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><T k="about.values" /></p>
        <h2 data-split>Ideas. Marketing. Creativity. Technology.</h2>
      </div>
      <div class="grid grid--4" data-reveal-group>
        {values.map((v) => (
          <div class="value" data-reveal>
            <span class="icon-tile icon-tile--white icon-tile--round"><Icon name={v.icon} /></span>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
    <Ridge to="var(--bg)" flip />
  </section>

  <Stats ridgeTo="var(--dusk-sky-top)" />

  <section class="section about-dusk" data-parallax-scope>
    <Image class="about-dusk__photo" src={kathmanduSunset} alt="The Himalayas at sunset, seen from the Kathmandu valley" width={1800} height={1000} quality={78} aria-hidden="true" />
    <div class="about-dusk__wash" aria-hidden="true"></div>
    <div class="about-dusk__mtn" data-parallax="0.08" aria-hidden="true"><Mountains /></div>
    <div class="container about-dusk__inner">
      <p class="caps about-dusk__eyebrow" data-reveal><Icon name="sun" size={14} /> {site.location.city}, {site.location.country}</p>
      <h2 class="about-dusk__headline" data-split>{site.phrases.localBusiness}</h2>
      <p class="lead about-dusk__lead" data-reveal style="--reveal-delay:150ms">
        From Boudha to Patan, Thamel to Baneshwor — this valley is home, not a client list. Every project we ship watches the same sunset over the same hills.
      </p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .about-hero__card {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding: var(--space-7);
    text-align: center;
  }
  .story { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-8); align-items: start; }
  @media (min-width: 1024px) { .story { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); } }
  .story__text .script { font-size: var(--text-2xl); }
  .story__side { display: grid; gap: var(--space-5); }
  .story__kathmandu {
    position: relative;
    overflow: hidden;
    padding: 0;
    min-height: 320px;
    display: flex;
    align-items: flex-end;
    color: #fff;
    border-color: transparent;
  }
  .story__kathmandu :global(.story__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .story__kathmandu-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(11, 11, 11, 0.92) 0%, rgba(11, 11, 11, 0.55) 45%, rgba(11, 11, 11, 0.1) 75%);
  }
  .story__kathmandu-body { position: relative; padding: var(--space-6); }
  .story__kathmandu-body svg:first-of-type { color: var(--brand-orange); }
  .story__kathmandu-body h3 { margin-top: var(--space-4); }
  .story__kathmandu-body p { margin: 0 0 var(--space-2); opacity: 0.85; }
  .milestones { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); }
  .milestones li {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  .milestones__year {
    font-family: var(--font-heading);
    font-weight: 800;
    color: var(--accent);
    min-width: 3.5em;
  }
  .values-sec { overflow: hidden; }
  .values-sec__mark { position: absolute; right: -8%; top: -20%; opacity: 0.08; pointer-events: none; }
  .values-sec .section-head h2 :global(.word) { display: inline-block; }
  .value { display: grid; gap: var(--space-3); }
  .value h3 { margin: 0; font-size: var(--text-xl); }
  .value p { margin: 0; opacity: 0.9; }
  .about-dusk {
    position: relative;
    overflow: hidden;
    text-align: center;
    /* Fallback shown instantly, before the photo below has painted */
    background: var(--dusk-gradient);
    color: var(--dusk-fg);
  }
  .about-dusk :global(.about-dusk__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about-dusk__wash {
    /* The brand's dusk gradient laid over the real photo, tying it to the same
       recipe used for the gradient-fill headline above — and keeping the
       foreground text at guaranteed contrast regardless of the photo's own tones. */
    position: absolute;
    inset: 0;
    background: var(--dusk-gradient);
    opacity: 0.72;
    mix-blend-mode: multiply;
  }
  .about-dusk__mtn {
    position: absolute;
    inset: auto 0 -6% 0;
    color: #050505;
    opacity: 0.5;
    pointer-events: none;
  }
  .about-dusk__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }
  .about-dusk__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--dusk-fg);
    opacity: 0.85;
  }
  .about-dusk__headline {
    margin: 0;
    color: var(--dusk-fg);
    font-size: var(--text-4xl);
  }
  .about-dusk__headline :global(.word) { display: inline-block; }
  .about-dusk__lead {
    margin: 0;
    color: var(--dusk-fg-muted);
    max-width: 62ch;
  }
</style>
