---
import Base from '../layouts/Base.astro';
import HomeHero from '../components/home/HomeHero.astro';
import ClientLogos from '../components/home/ClientLogos.astro';
import WorkReel from '../components/home/WorkReel.astro';
import ServicesIndex from '../components/home/ServicesIndex.astro';
import Results from '../components/home/Results.astro';
import StandFeature from '../components/home/StandFeature.astro';
import ClientStories from '../components/home/ClientStories.astro';
import TeamWall from '../components/home/TeamWall.astro';
import HowWeWork from '../components/home/HowWeWork.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { site } from '../config/site';

const localBusinessLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.description,
  url: Astro.site?.toString(),
  telephone: site.contact.phone,
  email: site.contact.email,
  address: { '@type': 'PostalAddress', streetAddress: site.location.addressLine, addressLocality: site.location.city, addressCountry: 'NP' },
  geo: { '@type': 'GeoCoordinates', latitude: site.location.geo.lat, longitude: site.location.geo.lng },
  openingHours: 'Mo-Su 06:00-22:00',
  areaServed: 'Nepal',
  priceRange: 'NPR',
};
---

<!--
  The homepage runs from midday to night: orange hero, proof in white and black, the dusk
  sky at the results, and a night-sky footer. Each section ends in a ridgeline coloured
  like the section below it (components/home/Ridge.astro).
-->
<Base headerTone="white" jsonLd={[localBusinessLd]}>
  <HomeHero />
  <ClientLogos />
  <WorkReel />
  <ServicesIndex />
  <Results />
  {site.features.preorder && <StandFeature />}
  {site.features.testimonials && <ClientStories />}
  <TeamWall />
  <HowWeWork />
  <CtaBand />
</Base>
