---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Marquee from '../components/sections/Marquee.astro';
import ServicesGrid from '../components/sections/ServicesGrid.astro';
import ProductSpotlight from '../components/sections/ProductSpotlight.astro';
import Process from '../components/sections/Process.astro';
import WhyUs from '../components/sections/WhyUs.astro';
import PrayerFlags from '../components/PrayerFlags.astro';
import Stats from '../components/sections/Stats.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import PricingTeaser from '../components/sections/PricingTeaser.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { site } from '../config/site';

const featured = [
  'social-media-management',
  'social-media-marketing',
  'ai-video-production',
  'ai-graphics-design',
  'ai-smart-reviews-qr',
  'meta-ads',
  'google-ads',
  'website-design-development',
];

const localBusinessLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.description,
  url: Astro.site?.toString(),
  telephone: site.contact.phone,
  email: site.contact.email,
  address: { '@type': 'PostalAddress', streetAddress: site.location.addressLine, addressLocality: site.location.city, addressCountry: 'NP' },
  geo: { '@type': 'GeoCoordinates', latitude: site.location.geo.lat, longitude: site.location.geo.lng },
  openingHours: 'Mo-Su 06:00-22:00',
  areaServed: 'Nepal',
  priceRange: 'NPR',
};
---

<Base headerTone="white" jsonLd={[localBusinessLd]}>
  <Hero />
  <Marquee keys={['marquee.a', 'marquee.b', 'marquee.c', 'marquee.d', 'marquee.e']} />
  <ServicesGrid featured={featured} />
  <ProductSpotlight />
  <Process />
  <WhyUs />
  <div class="prayer-flags-band">
    <PrayerFlags />
  </div>
  {site.features.stats && <Stats />}
  {site.features.testimonials && <Testimonials />}
  {site.features.pricingPage && <PricingTeaser />}
  <CtaBand />
</Base>

<style>
  .prayer-flags-band {
    width: 100%;
    padding-block: var(--space-4);
    background: var(--bg-muted);
    overflow: hidden;
  }
</style>
