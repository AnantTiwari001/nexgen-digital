---
/**
 * Drag-to-compare before/after reveal — part of the traced-line signature
 * moment system (see PLAN.md "Signature Moments"). Auto-sweeps open the moment
 * it scrolls into view, so the story is told without asking the visitor to do
 * anything; manual drag still works afterward for anyone who wants to explore.
 * Only rendered on services.ts entries with a `beforeAfter` field (currently
 * AI Graphics Design only — the "before and after" framing only fits a design
 * service literally about transforming a piece of content).
 */
import type { BeforeAfterDemo } from '../../data/types';

interface Props {
  data: BeforeAfterDemo;
}
const { data } = Astro.props;
const id = 'ba-' + Math.random().toString(36).slice(2, 8);
---

<section class="section ba-section">
  <div class="container container--narrow">
    <p class="eyebrow center"><span class="dot"></span> Before and after, told without asking</p>
    <h2 class="center">Drag to see the difference — or just watch it happen</h2>
    <p class="lead center ba-section__lead">The reveal below plays on its own the moment it scrolls into view.</p>
  </div>
  <div class="container container--narrow">
    <div class="ba-frame" id={id} data-ba-frame>
      <div class="ba-layer ba-before">
        <div class="ba-post">
          <div class="ba-photo">photo.jpg</div>
          <p class="ba-caption">{data.beforeCaption}</p>
        </div>
      </div>
      <div class="ba-layer ba-after" data-ba-after>
        <div class="ba-post">
          <div class="ba-photo">Hero shot, shot &amp; lit</div>
          <p class="ba-caption">{data.afterCaption}</p>
          <span class="ba-tag">{data.afterTag}</span>
        </div>
      </div>
      <span class="ba-label ba-label--before">Before</span>
      <span class="ba-label ba-label--after">After</span>
      <div class="ba-handle" data-ba-handle><span class="ba-grip">⇔</span></div>
    </div>
  </div>
</section>

<style>
  .ba-section__lead { margin-inline: auto; margin-top: var(--space-2); }
  .ba-section .eyebrow { justify-content: center; }
  .ba-section .eyebrow .dot {
    width: 7px; height: 7px; border-radius: 50%; background: var(--accent); display: inline-block;
    animation: ba-pulse 1.8s ease-in-out infinite;
  }
  @keyframes ba-pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .5; transform: scale(1.5); } }

  .ba-frame {
    position: relative;
    margin-top: var(--space-7);
    aspect-ratio: 16 / 10;
    max-height: 520px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    touch-action: pan-y;
    user-select: none;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
  }
  .ba-layer { position: absolute; inset: 0; display: flex; flex-direction: column; }
  .ba-before { background: #e9e9e9; color: #333; }
  .ba-after {
    background: linear-gradient(160deg, var(--brand-orange-300), var(--brand-orange) 60%, var(--brand-orange-700));
    color: #fff;
    clip-path: inset(0 calc(100% - var(--pos, 0%)) 0 0);
    transition: clip-path 1.2s cubic-bezier(.22, 1, .36, 1);
  }
  .ba-post { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; padding: var(--space-6); }
  .ba-photo {
    flex: 1; margin: var(--space-5) var(--space-5) 0; border-radius: var(--radius-md);
    display: grid; place-items: center; font-family: var(--font-heading); font-weight: 700;
    font-size: var(--text-xs); letter-spacing: 0.08em; text-transform: uppercase;
  }
  .ba-before .ba-photo { background: #cfcfcf; color: #8a8a8a; border: 1px dashed #aaa; }
  .ba-after .ba-photo { background: rgba(255, 255, 255, 0.14); color: rgba(255, 255, 255, 0.85); border: 1px dashed rgba(255, 255, 255, 0.4); }
  .ba-caption { margin-top: var(--space-4); font-size: var(--text-sm); }
  .ba-before .ba-caption { color: #555; font-family: Arial, sans-serif; }
  .ba-after .ba-caption { font-family: var(--font-body); font-weight: 500; }
  .ba-after .ba-tag {
    display: inline-flex; align-self: flex-start; margin-top: var(--space-2); padding: 0.35em 0.8em;
    border-radius: var(--radius-pill); background: var(--brand-black); font-family: var(--font-heading);
    font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.05em;
  }
  .ba-label {
    position: absolute; top: var(--space-4); font-family: var(--font-heading); font-weight: 800;
    font-size: var(--text-xs); letter-spacing: 0.1em; text-transform: uppercase; padding: 0.4em 0.85em;
    border-radius: var(--radius-pill); background: rgba(0, 0, 0, 0.55); color: #fff; backdrop-filter: blur(4px);
  }
  .ba-label--before { left: var(--space-4); }
  .ba-label--after { right: var(--space-4); }
  .ba-handle {
    position: absolute; top: 0; bottom: 0; left: var(--pos, 0%); width: 0;
    display: flex; align-items: center; justify-content: center; cursor: ew-resize;
    transition: left 1.2s cubic-bezier(.22, 1, .36, 1);
  }
  .ba-handle::before {
    content: ''; position: absolute; inset: 0; width: 3px; left: -1.5px; background: #fff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.15), 0 0 10px 2px rgba(255, 180, 84, 0.85);
  }
  .ba-grip {
    width: 44px; height: 44px; border-radius: 50%; background: #fff; color: var(--brand-black);
    display: grid; place-items: center; box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35); font-size: 16px; font-weight: 900;
  }
</style>

<script>
  import { onEnterOnce } from '../../scripts/trace';

  document.querySelectorAll<HTMLElement>('[data-ba-frame]').forEach((frame) => {
    const after = frame.querySelector<HTMLElement>('[data-ba-after]')!;
    const handle = frame.querySelector<HTMLElement>('[data-ba-handle]')!;
    let dragging = false;

    function setPos(pct: number, animated: boolean) {
      pct = Math.max(4, Math.min(96, pct));
      after.style.transition = animated ? '' : 'none';
      handle.style.transition = animated ? '' : 'none';
      after.style.setProperty('--pos', pct + '%');
      handle.style.setProperty('--pos', pct + '%');
    }
    function setFromClientX(clientX: number) {
      const r = frame.getBoundingClientRect();
      setPos(((clientX - r.left) / r.width) * 100, false);
    }
    function down(e: PointerEvent | TouchEvent) {
      dragging = true;
      setFromClientX('touches' in e ? e.touches[0].clientX : (e as PointerEvent).clientX);
      e.preventDefault();
    }
    function move(e: PointerEvent | TouchEvent) {
      if (!dragging) return;
      setFromClientX('touches' in e ? e.touches[0].clientX : (e as PointerEvent).clientX);
    }
    function up() {
      dragging = false;
    }
    handle.addEventListener('pointerdown', down);
    frame.addEventListener('pointerdown', down);
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', up);
    frame.addEventListener('touchstart', down, { passive: false });
    frame.addEventListener('touchmove', move, { passive: false });
    window.addEventListener('touchend', up);

    onEnterOnce(frame, () => setPos(58, true), 0.45);
  });
</script>
