---
import SectionHead from '../SectionHead.astro';
import T from '../T.astro';
import Logo from '../Logo.astro';
import { stats, trustedBy } from '../../data/stats';
const anyPlaceholder = stats.some((s) => s.placeholder);
---

<section class="section section--tight stats">
  <div class="container">
    <SectionHead eyebrow="stats.eyebrow" title="stats.title" align="center" />
    <div class="stats__grid" data-reveal-group>
      {stats.map((s) => (
        <div class="stats__item" data-reveal>
          <span class="stats__num" data-counter={s.value} data-prefix={s.prefix ?? ''} data-suffix={s.suffix ?? ''} data-decimals={Number.isInteger(s.value) ? 0 : 1}>
            {s.prefix}{s.value}{s.suffix}
          </span>
          <span class="stats__label">{s.label}</span>
        </div>
      ))}
    </div>
    {anyPlaceholder && <p class="center small muted stats__note"><T k="stats.placeholder" /></p>}

    <div class="gl-stage" data-reveal>
      <div class="gl-card" data-gl-card>
        <div class="gl-head">
          <span class="gl-num">+312%</span>
          <span class="gl-lbl">Reach, 90 days</span>
        </div>
        <div class="gl-chart">
          <svg viewBox="0 0 340 150" preserveAspectRatio="none" aria-hidden="true">
            <path data-gl-path class="trace-path" d="M10,120 L80,95 L140,105 L200,55 L260,68 L325,15" />
            <circle class="trace-dot" cx="10" cy="120" r="4" />
            <circle class="trace-dot" cx="80" cy="95" r="4" />
            <circle class="trace-dot" cx="140" cy="105" r="4" />
            <circle class="trace-dot" cx="200" cy="55" r="4" />
            <circle class="trace-dot" cx="260" cy="68" r="4" />
            <circle class="trace-dot" cx="325" cy="15" r="5" />
          </svg>
          <div class="spark-wrap" data-gl-sparks style="left:325px; top:15px;"></div>
        </div>
        <p class="gl-note muted small">Illustrative sample. Your own dashboard replaces this once work begins.</p>
      </div>
    </div>

    <div class="stats__logos marquee" style="--marquee-speed:40s" aria-hidden="true">
      <div class="marquee__track">
        {[...trustedBy, ...trustedBy].map((b) => (
          <span class="stats__logo"><Logo variant="mark" height={16} /> {b.name}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .stats__grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }
  .stats__item {
    text-align: center;
    padding: var(--space-6) var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--bg-muted);
    display: grid;
    gap: var(--space-2);
  }
  .stats__num {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: var(--text-5xl);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--accent);
  }
  .stats__label {
    font-weight: 600;
    color: var(--fg-muted);
  }
  .stats__note { margin-top: var(--space-4); }
  .stats__logos {
    margin-top: var(--space-7);
    opacity: 0.6;
  }
  .stats__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
    filter: grayscale(1);
  }

  /* ---- Growth chart: the traced-line system tied to an actual result ---- */
  .gl-stage {
    margin-top: var(--space-7);
    max-width: 520px;
    margin-inline: auto;
    perspective: 900px;
  }
  .gl-card {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: linear-gradient(165deg, #1d1712, #100c08);
    padding: var(--space-6) var(--space-5) var(--space-4);
    transform: rotateX(0deg);
    transition: transform 0.05s linear;
    will-change: transform;
    box-shadow: var(--shadow-lg);
  }
  .gl-head { display: flex; justify-content: space-between; align-items: baseline; }
  .gl-num { font-family: var(--font-heading); font-weight: 800; font-size: var(--text-3xl); color: var(--brand-gold); }
  .gl-lbl { font-family: var(--font-heading); font-weight: 700; font-size: var(--text-xs); letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255, 255, 255, 0.6); }
  .gl-chart { position: relative; margin-top: var(--space-4); height: 150px; }
  .gl-chart svg { width: 100%; height: 100%; overflow: visible; }
  .gl-note { margin-top: var(--space-3); color: rgba(255, 255, 255, 0.55) !important; }
</style>

<script>
  import { drawPath, onEnterOnce, revealDots, scrollTilt, spawnSparks } from '../../scripts/trace';

  const card = document.querySelector<HTMLElement>('[data-gl-card]');
  const path = document.querySelector<SVGPathElement>('[data-gl-path]');
  const dots = card?.querySelectorAll('.trace-dot') ?? [];

  onEnterOnce(
    card,
    () => {
      const duration = 1400;
      drawPath(path, duration, () => spawnSparks(document.querySelector<HTMLElement>('[data-gl-sparks]'), 6));
      revealDots(dots, duration);
    },
    0.4,
  );

  scrollTilt(card, 6);
</script>
