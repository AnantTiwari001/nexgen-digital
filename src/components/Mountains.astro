---
/**
 * Layered Himalayan silhouette used as a decorative background.
 * Uses currentColor so it can sit on any surface. Layers can be parallaxed individually.
 */
interface Props {
  class?: string;
  layers?: boolean;
}
const { class: className, layers = false } = Astro.props;
---

<svg class:list={['mountains', className]} viewBox="0 0 1440 320" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <path
    data-layer="back"
    data-parallax={layers ? '0.06' : undefined}
    fill="currentColor"
    opacity="0.45"
    d="M0 260 L90 205 L160 235 L250 150 L330 200 L410 120 L470 170 L560 95 L640 160 L720 110 L800 175 L880 130 L960 190 L1040 105 L1120 165 L1200 130 L1290 200 L1370 160 L1440 210 L1440 320 L0 320 Z"
  />
  <path
    data-layer="mid"
    data-parallax={layers ? '0.12' : undefined}
    fill="currentColor"
    opacity="0.7"
    d="M0 290 L70 245 L140 265 L230 195 L300 230 L390 170 L460 215 L540 150 L620 210 L700 165 L780 225 L860 185 L940 240 L1020 170 L1100 220 L1180 190 L1260 250 L1340 215 L1440 260 L1440 320 L0 320 Z"
  />
  <path
    data-layer="front"
    data-parallax={layers ? '0.2' : undefined}
    fill="currentColor"
    d="M0 320 L60 285 L130 300 L210 250 L280 280 L360 235 L430 270 L510 220 L590 265 L670 230 L750 275 L830 245 L910 285 L990 240 L1070 270 L1150 250 L1230 290 L1310 265 L1440 300 L1440 320 Z"
  />
</svg>

<style>
  .mountains {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
