---
/**
 * A photo or video at its final aspect ratio. With `src` (or `video`) it renders the
 * media; without, a clearly marked placeholder naming the shot that belongs there, so
 * real assets drop in by setting one field in src/data.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  ratio: string; // CSS aspect-ratio, e.g. "4 / 5"
  label: string; // what the shot is, e.g. "Team portrait"
  spec?: string; // how to shoot it, e.g. "4:5 · orange backdrop"
  src?: ImageMetadata | string;
  video?: string; // muted looping mp4
  alt?: string;
  initials?: string; // people placeholders show initials instead of an icon
  icon?: 'image' | 'user' | 'play';
  tone?: 'dark' | 'light' | 'orange';
  class?: string;
  eager?: boolean;
}
const { ratio, label, spec, src, video, alt = '', initials, icon = 'image', tone = 'dark', class: className, eager = false } = Astro.props;
---

<figure class:list={['slot', `slot--${tone}`, { 'slot--empty': !src && !video }, className]} style={`aspect-ratio:${ratio}`}>
  {video ? (
    <video src={video} autoplay muted loop playsinline preload="none" aria-label={alt}></video>
  ) : src ? (
    typeof src === 'string' ? (
      <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      <Image src={src} alt={alt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 40vw, 90vw" loading={eager ? 'eager' : 'lazy'} />
    )
  ) : (
    <figcaption class="slot__note">
      {initials ? <span class="slot__initials">{initials}</span> : <Icon name={icon} size={28} />}
      <span class="slot__label">{label}</span>
      {spec && <span class="slot__spec">{spec}</span>}
    </figcaption>
  )}
</figure>

<style>
  .slot {
    position: relative;
    margin: 0;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    isolation: isolate;
  }
  .slot img,
  .slot video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .slot--empty {
    display: grid;
    place-items: center;
    text-align: center;
    --slot-bg: #1c1c1c;
    --slot-fg: rgba(255, 255, 255, 0.72);
    --slot-line: rgba(255, 255, 255, 0.06);
    background:
      repeating-linear-gradient(135deg, var(--slot-line) 0 1px, transparent 1px 14px),
      var(--slot-bg);
    color: var(--slot-fg);
    border: 1px dashed color-mix(in srgb, var(--slot-fg) 35%, transparent);
  }
  .slot--light.slot--empty {
    --slot-bg: var(--bg-muted);
    --slot-fg: var(--fg-muted);
    --slot-line: color-mix(in srgb, var(--fg) 6%, transparent);
  }
  .slot--orange.slot--empty {
    --slot-bg: #e64f00;
    --slot-fg: rgba(255, 255, 255, 0.85);
    --slot-line: rgba(255, 255, 255, 0.08);
  }
  .slot__note {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    padding: var(--space-4);
    font-size: var(--text-xs);
    line-height: 1.4;
  }
  .slot__label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-sm);
  }
  .slot__spec { opacity: 0.75; }
  .slot__initials {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
</style>
