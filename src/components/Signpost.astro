---
/**
 * Small decorative cluster styled like a real Nepali highway/street directional
 * sign: dark green plate, white border, bilingual text (Devanagari place name over
 * its romanised form), optional distance. Pure CSS/markup, no photographic imagery.
 * Each block gets a small fixed tilt (from a deterministic list, not random, so
 * server and client render the same markup) for a hand-placed feel.
 */
export interface SignpostItem {
  devanagari: string;
  roman: string;
  distance?: string;
}
interface Props {
  items: SignpostItem[];
  class?: string;
}
const { items, class: className } = Astro.props;
// Small alternating tilts, degrees. Repeats if there are more than 6 items.
const tilts = [-2, 1.5, -1, 2, -1.5, 1];
---

<div class:list={['signpost', className]} role="list" aria-label="Directions around the Kathmandu valley">
  {items.map((item, i) => (
    <div class="signpost__item" role="listitem" style={`--signpost-tilt:${tilts[i % tilts.length]}deg`}>
      <span class="signpost__dev" lang="ne">{item.devanagari}</span>
      <span class="signpost__roman">{item.roman}</span>
      {item.distance && <span class="signpost__dist">{item.distance}</span>}
    </div>
  ))}
</div>

<style>
  .signpost {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .signpost__item {
    display: grid;
    gap: 0.2em;
    min-width: 8em;
    padding: var(--space-3) var(--space-4);
    background: #0b4a30;
    border: 3px solid #fff;
    border-radius: 6px;
    color: #fff;
    box-shadow: var(--shadow-md);
    transform: rotate(var(--signpost-tilt, -1deg));
    transition: transform var(--dur) var(--ease-out);
  }
  .signpost__item:hover {
    transform: rotate(0deg) translateY(-2px);
  }
  .signpost__dev {
    display: block;
    font-family: var(--font-ne);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.2;
  }
  .signpost__roman {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    opacity: 0.92;
  }
  .signpost__dist {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    opacity: 0.72;
    margin-top: 0.1em;
  }
  @media (max-width: 480px) {
    .signpost {
      gap: var(--space-3);
    }
    .signpost__item {
      min-width: 7em;
      padding: var(--space-2) var(--space-3);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .signpost__item {
      transition: none;
    }
  }
</style>
