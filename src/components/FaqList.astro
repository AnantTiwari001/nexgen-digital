---
import Icon from './Icon.astro';
import type { Faq } from '../data/types';

interface Props {
  items: Faq[];
  class?: string;
}
const { items, class: className } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<div class:list={['faq', className]} data-reveal-group>
  {items.map((f) => (
    <details class="faq__item" data-reveal>
      <summary class="faq__q">
        <span>{f.q}</span>
        <span class="faq__icon"><Icon name="arrow" size={18} /></span>
      </summary>
      <div class="faq__a"><p>{f.a}</p></div>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .faq {
    display: grid;
    gap: var(--space-3);
  }
  .faq__item {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-elev);
    overflow: hidden;
    transition: border-color var(--dur-fast);
  }
  .faq__item[open] { border-color: var(--accent); }
  .faq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    font-family: var(--font-heading);
    font-weight: 700;
    list-style: none;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    flex: none;
    transition: transform var(--dur) var(--ease-out);
  }
  .faq__item[open] .faq__icon { transform: rotate(90deg); }
  .faq__a {
    padding: 0 var(--space-5) var(--space-5);
    color: var(--fg-muted);
  }
  .faq__a p { margin: 0; }
</style>
