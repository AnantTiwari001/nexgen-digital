---
/**
 * Case studies under the dusk sky: the client's photo with the result printed large on
 * it, then who, which service and what was done. The valley at sunset sits faintly at
 * the horizon so the gradient reads as sky, not decoration.
 */
import { Image } from 'astro:assets';
import T from '../T.astro';
import ResultCard from '../ResultCard.astro';
import Echo from './Echo.astro';
import Ridge from './Ridge.astro';
import { caseStudies } from '../../data/work';
import { t } from '../../i18n';
import valley from '../../assets/kathmandu/kathmandu-valley-sunset.jpg';
---

<section class="band-dusk results" id="results">
  <div class="band-dusk__valley" aria-hidden="true">
    <Image src={valley} alt="" widths={[960, 1600]} sizes="100vw" loading="lazy" />
  </div>
  <div class="container">
    <div class="band-dusk__head">
      <T k="home.results.eyebrow" as="p" class="eyebrow" />
      <T k="home.results.title" as="h2" />
      <Echo text={t('home.results.echo')} />
      <T k="home.results.lead" as="p" class="lead" />
    </div>
    <div class="band-dusk__grid" data-reveal-group>
      {caseStudies.map((c) => (
        <ResultCard
          metric={c.metric}
          metricLabel={c.metricLabel}
          client={c.client}
          meta={`${c.area} · ${c.serviceName}`}
          summary={c.summary}
          photo={c.photo}
          href={`/services/${c.service}`}
          placeholder={c.placeholder}
        />
      ))}
    </div>
  </div>
  <Ridge to="var(--brand-orange)" />
</section>
