---
/**
 * Case studies under the dusk sky: the client's photo with the result printed large on
 * it, then who, which service and what was done. The valley at sunset sits faintly at
 * the horizon so the gradient reads as sky, not decoration.
 */
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import T from '../T.astro';
import MediaSlot from '../MediaSlot.astro';
import Echo from './Echo.astro';
import Ridge from './Ridge.astro';
import { caseStudies } from '../../data/work';
import { t } from '../../i18n';
import valley from '../../assets/kathmandu/kathmandu-valley-sunset.jpg';
---

<section class="results" id="results">
  <div class="results__valley" aria-hidden="true">
    <Image src={valley} alt="" widths={[960, 1600]} sizes="100vw" loading="lazy" />
  </div>
  <div class="container results__inner">
    <div class="results__head">
      <T k="home.results.eyebrow" as="p" class="eyebrow" />
      <T k="home.results.title" as="h2" class="results__title" />
      <Echo text={t('home.results.echo')} />
      <T k="home.results.lead" as="p" class="lead results__lead" />
    </div>

    <div class="results__grid" data-reveal-group>
      {caseStudies.map((c) => (
        <article class="results__card" data-reveal>
          <div class="results__media">
            <MediaSlot ratio="4 / 5" src={c.photo} alt={`${c.client}, ${c.area}`} label="Client photo" spec="4:5 · owner or venue" />
            <p class="results__metric"><strong>{c.metric}</strong><span>{c.metricLabel}</span></p>
            {c.placeholder && <span class="results__sample" data-i18n="home.results.sample">{t('home.results.sample')}</span>}
          </div>
          <div class="results__body">
            <p class="results__client">{c.client}</p>
            <p class="results__meta">{c.area} · {c.serviceName}</p>
            <p class="results__summary">{c.summary}</p>
            <a class="results__link" href={`/services/${c.service}`}><T k="home.results.read" /><Icon name="arrow" size={16} /></a>
          </div>
        </article>
      ))}
    </div>
  </div>
  <Ridge to="var(--brand-orange)" />
</section>

<style>
  .results {
    position: relative;
    background: var(--dusk-gradient);
    color: var(--dusk-fg);
    padding-block: var(--section-y) calc(var(--section-y) + 5rem);
    overflow: hidden;
    isolation: isolate;
  }
  .results__valley {
    position: absolute;
    inset: auto 0 0 0;
    height: 55%;
    z-index: -1;
    opacity: 0.32;
    mix-blend-mode: soft-light;
    mask-image: linear-gradient(to bottom, transparent, #000 45%);
  }
  .results__valley img { width: 100%; height: 100%; object-fit: cover; object-position: center 70%; }
  .results__inner { position: relative; }
  .results__head { max-width: 760px; margin-bottom: var(--space-7); --echo: #ffcf9f; }
  .results__head :global(.eyebrow) { color: #ffcf9f; }
  .results__title { color: #fff; }
  .results__lead { color: var(--dusk-fg-muted); margin: 0; }

  .results__grid { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .results__card {
    display: grid;
    align-content: start;
    background: rgba(11, 6, 20, 0.42);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: calc(var(--radius-lg) + 6px);
    padding: 8px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .results__media { position: relative; }
  .results__media::after {
    content: '';
    position: absolute;
    inset: 40% 0 0 0;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    background: linear-gradient(to bottom, transparent, rgba(11, 6, 20, 0.85));
    pointer-events: none;
  }
  .results__metric {
    position: absolute;
    left: var(--space-5);
    right: var(--space-5);
    bottom: var(--space-4);
    z-index: 1;
    margin: 0;
    display: grid;
    gap: 2px;
  }
  .results__metric strong {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(3.2rem, 2.4rem + 3vw, 4.8rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: var(--brand-gold);
  }
  .results__metric span { font-weight: 600; color: #fff; }
  .results__sample {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 1;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: rgba(0, 0, 0, 0.55);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .results__body { display: grid; gap: var(--space-2); padding: var(--space-5) var(--space-4) var(--space-4); }
  .results__body p { margin: 0; }
  .results__client { font-family: var(--font-heading); font-weight: 700; font-size: var(--text-xl); }
  .results__meta { font-size: var(--text-sm); color: #ffcf9f; }
  .results__summary { color: var(--dusk-fg-muted); font-size: var(--text-sm); }
  .results__link { display: inline-flex; align-items: center; gap: 0.4em; margin-top: var(--space-2); font-family: var(--font-heading); font-weight: 700; color: #fff; }
  .results__link:hover { color: var(--brand-gold); }
  @media (max-width: 600px) {
    .results__media :global(.slot) { aspect-ratio: 4 / 3 !important; }
  }
</style>
