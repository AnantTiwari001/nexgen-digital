---
/**
 * Client stories: one owner photographed in their own shop with their words beside them,
 * then shorter quotes, with the Google rating in the heading row. Quotes come from
 * src/data/testimonials.ts (`avatar` holds the owner's photo).
 */
import Icon from '../Icon.astro';
import T from '../T.astro';
import StoryFeature from '../StoryFeature.astro';
import Echo from './Echo.astro';
import Ridge from './Ridge.astro';
import { testimonials } from '../../data/testimonials';
import { stats } from '../../data/stats';
import { t } from '../../i18n';

const [featured, ...rest] = testimonials;
const others = rest.slice(0, 3);
const rating = stats.find((s) => s.suffix === '/5');
const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
---

<section class="stories" id="stories">
  <div class="container">
    <div class="stories__head">
      <div>
        <T k="home.stories.eyebrow" as="p" class="eyebrow" />
        <T k="home.stories.title" as="h2" />
        <Echo text={t('home.stories.echo')} />
      </div>
      {rating && (
        <p class="stories__rating">
          <strong>{rating.value}</strong>
          <span class="stories__stars" aria-label={`${rating.value} out of 5 stars`}>{[0, 1, 2, 3, 4].map(() => <Icon name="star" size={18} />)}</span>
          <span><T k="home.stories.rating" /></span>
        </p>
      )}
    </div>

    {featured && <div class="stories__featured"><StoryFeature item={featured} /></div>}

    <div class="stories__grid" data-reveal-group>
      {others.map((q) => (
        <figure class="stories__card" data-reveal>
          <div class="stories__card-stars" aria-label={`${q.rating} out of 5 stars`}>{Array.from({ length: q.rating }).map(() => <Icon name="star" size={14} />)}</div>
          <blockquote>{q.quote}</blockquote>
          <figcaption>
            <span class="stories__avatar">{q.avatar ? <img src={q.avatar} alt="" loading="lazy" /> : initials(q.business)}</span>
            <span><strong>{q.business}</strong><br />{q.location}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
  <Ridge to="var(--brand-orange)" flip />
</section>

<style>
  .stories { position: relative; background: var(--bg); padding-block: var(--section-y) calc(var(--section-y) + 4rem); }
  .stories__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
  }
  .stories__rating {
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: 0 var(--space-3);
    margin: 0 0 var(--space-5);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
  .stories__rating strong {
    grid-row: span 2;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(3rem, 2.4rem + 2vw, 4rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--fg);
  }
  .stories__stars { display: inline-flex; color: var(--brand-gold); }

  .stories__featured { margin-bottom: var(--space-6); }

  .stories__grid { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .stories__card {
    margin: 0;
    display: grid;
    gap: var(--space-4);
    align-content: space-between;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--bg-muted);
  }
  .stories__card-stars { display: flex; color: var(--brand-gold); }
  .stories__card blockquote { margin: 0; font-size: var(--text-base); }
  .stories__card figcaption { display: flex; align-items: center; gap: var(--space-3); font-size: var(--text-sm); color: var(--fg-muted); }
  .stories__card figcaption strong { color: var(--fg); font-family: var(--font-heading); }
  .stories__avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: var(--text-sm);
  }
  .stories__avatar img { width: 100%; height: 100%; object-fit: cover; }
</style>
