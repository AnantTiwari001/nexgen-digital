---
/** Inner-page hero: bold orange surface, eyebrow, title, lead, optional visual slot. */
import Mountains from './Mountains.astro';
import KathmanduSkyline from './KathmanduSkyline.astro';
import Logo from './Logo.astro';
import Echo from './home/Echo.astro';
import Ridge from './home/Ridge.astro';
import { echoFor } from '../i18n';

interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  script?: string;
  align?: 'left' | 'center';
  tone?: 'orange' | 'black' | 'light';
  compact?: boolean;
  /** i18n keys for eyebrow/title/lead, so the client language toggle can swap this text too. */
  eyebrowKey?: string;
  titleKey?: string;
  leadKey?: string;
  /** Extra class on the <h1>, e.g. a one-off treatment like `text-gradient-dusk` for a single page. */
  titleClass?: string;
  /** Nepali echo under the title; defaults to the title key's Nepali translation. */
  echo?: string;
  /** Colour of the section below, which rises into the hero as a ridgeline. */
  ridgeTo?: string;
}
const { eyebrow, title, lead, script, align = 'left', tone = 'orange', compact = false, eyebrowKey, titleKey, leadKey, titleClass, echo, ridgeTo = 'var(--bg)' } = Astro.props;
const echoText = echo ?? echoFor(titleKey);
---

<section class:list={['phero', `phero--${tone}`, `phero--${align}`, { 'phero--compact': compact }]} data-parallax-scope>
  <div class="phero__mark" data-parallax="0.12" aria-hidden="true"><Logo variant="mark" height={420} tone="white" /></div>
  <div class="phero__mountains" aria-hidden="true"><Mountains /></div>
  <div class="phero__skyline" aria-hidden="true"><KathmanduSkyline /></div>
  <div class="container phero__inner">
    <div class="phero__text">
      {(eyebrow || Astro.slots.has('eyebrow')) && <p class="eyebrow" data-reveal data-i18n={eyebrowKey}><slot name="eyebrow">{eyebrow}</slot></p>}
      {(title || Astro.slots.has('title')) && <h1 class:list={['phero__title', titleClass]} data-split="immediate" data-split-delay="0.1" data-i18n={titleKey}><slot name="title">{title}</slot></h1>}
      {echoText && <Echo text={echoText} class="phero__echo" />}
      {script && <p class="script phero__script" data-reveal style="--reveal-delay:400ms">{script}</p>}
      {(lead || Astro.slots.has('lead')) && <p class="lead" data-reveal style="--reveal-delay:500ms" data-i18n={leadKey}><slot name="lead">{lead}</slot></p>}
      <div data-reveal style="--reveal-delay:600ms"><slot /></div>
    </div>
    {Astro.slots.has('visual') && <div class="phero__visual" data-reveal="scale" data-tilt="4" style="--reveal-delay:300ms"><slot name="visual" /></div>}
  </div>
  <Ridge to={ridgeTo} />
</section>

<style>
  .phero {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--header-h) + var(--space-8));
    padding-bottom: calc(var(--space-8) + clamp(44px, 7vw, 120px));
    background: var(--brand-orange);
    color: #fff;
    --echo: #fff3d6;
  }
  .phero--black { --echo: var(--brand-orange); }
  .phero--light { --echo: var(--accent); }
  .phero--black { background: var(--brand-black); }
  .phero--light {
    background: var(--bg-soft);
    color: var(--fg);
  }
  .phero--compact { padding-top: calc(var(--header-h) + var(--space-6)); padding-bottom: calc(var(--space-6) + clamp(44px, 7vw, 120px)); }
  @media (max-width: 640px) {
    /* Keep short-hero pages (e.g. contact, with a form right below) from placing
       their first controls under the fixed chat launcher in the bottom-right corner. */
    .phero--compact { padding-bottom: calc(var(--space-4) + 44px); }
  }
  .phero__mark {
    position: absolute;
    right: -4%;
    top: -14%;
    opacity: 0.1;
    pointer-events: none;
  }
  .phero--light .phero__mark { opacity: 0.06; }
  .phero--light .phero__mark :global(.logo) { --logo-mark: var(--brand-orange); }
  .phero__mountains {
    position: absolute;
    inset: auto 0 -14% 0;
    color: #0b0b0b;
    opacity: 0.14;
    pointer-events: none;
  }
  .phero--black .phero__mountains { color: #fff; opacity: 0.06; }
  .phero--light .phero__mountains { color: var(--brand-orange); opacity: 0.08; }
  .phero__skyline {
    position: absolute;
    inset: auto 0 -8% 0;
    color: #0b0b0b;
    opacity: 0.16;
    pointer-events: none;
  }
  .phero--black .phero__skyline { color: #fff; opacity: 0.07; }
  .phero--light .phero__skyline { color: var(--brand-orange); opacity: 0.09; }
  .phero__inner {
    position: relative;
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  .phero__inner:has(.phero__visual) {
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 1024px) {
    .phero__inner:has(.phero__visual) { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); }
  }
  .phero--center .phero__text {
    text-align: center;
    margin-inline: auto;
    max-width: 800px;
  }
  .phero--center .lead { margin-inline: auto; }
  .phero__title {
    font-size: var(--text-5xl);
    color: inherit;
  }
  .phero__title :global(.word) { display: inline-block; }
  .phero__script {
    font-size: var(--text-2xl);
    color: inherit;
    transform: rotate(-2deg);
    display: inline-block;
  }
  .phero--orange .eyebrow,
  .phero--black .eyebrow { color: #fff; }
  .phero--orange .lead,
  .phero--black .lead { color: inherit; opacity: 0.92; }
  .phero__visual { display: grid; place-items: center; }
</style>
