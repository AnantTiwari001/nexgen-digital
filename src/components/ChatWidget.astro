---
/**
 * Lead-capture chat assistant. Rule-based answers come from /api/chat; when the
 * bot cannot answer, or when the visitor leaves contact details, the transcript is
 * emailed to the team.
 */
import Icon from './Icon.astro';
import T from './T.astro';
import { t } from '../i18n';
import { knowledge } from '../data/faq';
import { whatsappUrl } from '../config/site';

const suggestions = knowledge.filter((k) => ['services', 'pricing', 'qr', 'start'].includes(k.id));
---

<div class="chat" data-chat>
  <button class="chat__fab" type="button" data-chat-toggle aria-expanded="false" aria-controls="chat-panel" aria-label={t('chat.open')}>
    <Icon name="chat" size={26} class="chat__fab-icon" />
    <Icon name="close" size={26} class="chat__fab-close" />
    <span class="chat__fab-label"><T k="chat.open" /></span>
  </button>

  <section class="chat__panel" id="chat-panel" data-chat-panel hidden aria-label="Chat assistant">
    <header class="chat__head">
      <div class="chat__avatar"><span>N</span></div>
      <div>
        <strong><T k="chat.title" /></strong>
        <div class="chat__status"><span class="dot"></span> <T k="chat.online" /></div>
      </div>
      <button class="chat__close" type="button" data-chat-close aria-label={t('nav.close')}><Icon name="close" size={20} /></button>
    </header>

    <div class="chat__log" data-chat-log role="log" aria-live="polite">
      <div class="msg msg--bot"><T k="chat.greeting" /></div>
      <div class="chat__suggest" data-chat-suggest>
        <div class="caps chat__suggest-h"><T k="chat.suggestions" /></div>
        {suggestions.map((s) => (
          <button type="button" class="chip" data-chat-q={s.question}>{s.question}</button>
        ))}
      </div>
    </div>

    <form class="chat__lead" data-chat-lead hidden>
      <p class="small"><T k="chat.askContact" /></p>
      <input class="input" name="name" placeholder={t('chat.name')} data-i18n-attr="placeholder:chat.name" required autocomplete="name" />
      <input class="input" name="contact" placeholder={t('chat.contact')} data-i18n-attr="placeholder:chat.contact" required autocomplete="tel" />
      <button class="btn btn--sm" type="submit"><T k="chat.submitLead" /><Icon name="send" size={16} /></button>
    </form>

    <form class="chat__form" data-chat-form>
      <input class="input" name="message" placeholder={t('chat.placeholder')} data-i18n-attr="placeholder:chat.placeholder" autocomplete="off" required maxlength="500" />
      <button class="chat__send" type="submit" aria-label={t('chat.send')}><Icon name="send" size={20} /></button>
    </form>
    <footer class="chat__foot">
      <span><T k="chat.poweredBy" /></span>
      <a href={whatsappUrl()} target="_blank" rel="noopener"><Icon name="whatsapp" size={14} /> WhatsApp</a>
    </footer>
  </section>
</div>

<style>
  .chat {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 120;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-3);
  }
  .chat__fab {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0 22px 0 16px;
    height: 56px;
    border-radius: var(--radius-pill);
    background: var(--brand-orange);
    color: #fff;
    border: 0;
    box-shadow: var(--shadow-accent);
    font-family: var(--font-heading);
    font-weight: 700;
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur);
  }
  .chat__fab:hover { transform: translateY(-2px) scale(1.02); }
  .chat__fab :global(.chat__fab-close) { display: none; }
  .chat[data-open] .chat__fab :global(.chat__fab-close) { display: block; }
  .chat[data-open] .chat__fab :global(.chat__fab-icon) { display: none; }
  .chat[data-open] .chat__fab-label { display: none; }
  .chat[data-open] .chat__fab { padding: 0 16px; }
  @media (max-width: 520px) {
    .chat__fab-label { display: none; }
    .chat__fab { padding: 0 16px; }
  }

  .chat__panel {
    width: min(380px, calc(100vw - 32px));
    height: min(600px, calc(100dvh - 110px));
    display: flex;
    flex-direction: column;
    background: var(--bg-elev);
    color: var(--fg);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    transform-origin: bottom right;
    animation: chat-in 0.35s var(--ease-out);
  }
  .chat__panel[hidden] { display: none; }
  @keyframes chat-in {
    from { opacity: 0; transform: translateY(16px) scale(0.96); }
  }
  .chat__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--brand-black);
    color: #fff;
  }
  .chat__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--brand-orange);
    display: grid;
    place-items: center;
    font-family: var(--font-heading);
    font-weight: 800;
  }
  .chat__status {
    font-size: var(--text-xs);
    opacity: 0.8;
    display: flex;
    align-items: center;
    gap: 0.4em;
    color: #7ee0a2;
  }
  .chat__close {
    margin-left: auto;
    background: transparent;
    border: 0;
    color: #fff;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
  }
  .chat__close:hover { background: rgba(255, 255, 255, 0.12); }
  .chat__log {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--bg-muted);
  }
  .msg {
    max-width: 88%;
    padding: 0.75em 1em;
    border-radius: 18px;
    font-size: var(--text-sm);
    line-height: 1.5;
    animation: msg-in 0.3s var(--ease-out);
  }
  @keyframes msg-in {
    from { opacity: 0; transform: translateY(8px); }
  }
  .msg--bot {
    align-self: flex-start;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-bottom-left-radius: 6px;
  }
  .msg--user {
    align-self: flex-end;
    background: var(--brand-orange);
    color: #fff;
    border-bottom-right-radius: 6px;
  }
  .msg--typing span {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 3px;
    border-radius: 50%;
    background: var(--fg-subtle);
    animation: typing 1s infinite;
  }
  .msg--typing span:nth-child(2) { animation-delay: 0.15s; }
  .msg--typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes typing {
    0%, 60%, 100% { transform: translateY(0); }
    30% { transform: translateY(-4px); }
  }
  .msg :global(a.msg__link) {
    display: inline-flex;
    margin-top: 0.6em;
    padding: 0.4em 0.9em;
    border-radius: var(--radius-pill);
    background: var(--brand-black);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-xs);
  }
  .chat__suggest {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .chat__suggest-h { width: 100%; color: var(--fg-subtle); font-size: 10px; }
  .chip {
    padding: 0.45em 0.9em;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
    background: var(--bg-elev);
    font-size: var(--text-xs);
    font-weight: 600;
    font-family: var(--font-heading);
    transition: background-color var(--dur-fast), color var(--dur-fast), border-color var(--dur-fast);
  }
  .chip:hover {
    background: var(--brand-orange);
    border-color: var(--brand-orange);
    color: #fff;
  }
  .chat__lead {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--line);
    background: var(--bg-soft);
  }
  .chat__lead[hidden] { display: none; }
  .chat__lead p { margin: 0; }
  .chat__form {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-3);
    border-top: 1px solid var(--line);
  }
  .chat__send {
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 0;
    background: var(--brand-orange);
    color: #fff;
    display: grid;
    place-items: center;
  }
  .chat__foot {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    padding: 0 var(--space-4) var(--space-3);
    font-size: 11px;
    color: var(--fg-subtle);
  }
  .chat__foot a { display: inline-flex; align-items: center; gap: 0.3em; color: #1fa855; font-weight: 600; }
</style>

<script>
  import { getAttribution } from '../scripts/utm';

  const root = document.querySelector<HTMLElement>('[data-chat]');
  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-chat-toggle]')!;
    const panel = root.querySelector<HTMLElement>('[data-chat-panel]')!;
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-chat-close]')!;
    const log = root.querySelector<HTMLElement>('[data-chat-log]')!;
    const form = root.querySelector<HTMLFormElement>('[data-chat-form]')!;
    const lead = root.querySelector<HTMLFormElement>('[data-chat-lead]')!;
    const suggest = root.querySelector<HTMLElement>('[data-chat-suggest]')!;
    const input = form.querySelector<HTMLInputElement>('input[name="message"]')!;
    const history: { role: 'user' | 'bot'; text: string }[] = [];
    let unanswered = 0;

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      if (open) {
        root.setAttribute('data-open', '');
        input.focus();
      } else root.removeAttribute('data-open');
    };
    toggle.addEventListener('click', () => setOpen(panel.hidden));
    closeBtn.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && !panel.hidden && setOpen(false));

    const scroll = () => (log.scrollTop = log.scrollHeight);
    const add = (role: 'user' | 'bot', html: string, link?: { label: string; href: string }) => {
      const el = document.createElement('div');
      el.className = `msg msg--${role}`;
      el.innerHTML = html;
      if (link) {
        const a = document.createElement('a');
        a.className = 'msg__link';
        a.href = link.href;
        a.textContent = link.label;
        el.appendChild(document.createElement('br'));
        el.appendChild(a);
      }
      log.appendChild(el);
      history.push({ role, text: el.textContent ?? '' });
      scroll();
      return el;
    };
    const typing = () => {
      const el = document.createElement('div');
      el.className = 'msg msg--bot msg--typing';
      el.innerHTML = '<span></span><span></span><span></span>';
      log.appendChild(el);
      scroll();
      return el;
    };
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

    async function ask(message: string) {
      add('user', esc(message));
      suggest.remove();
      const t = typing();
      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message, lang: document.documentElement.getAttribute('data-lang') || 'en' }),
        });
        const data = await res.json();
        t.remove();
        add('bot', esc(data.answer), data.link);
        if (!data.matched) unanswered++;
        if (!data.matched || unanswered >= 1) lead.hidden = false;
        (window as any).track?.('chat_message', { matched: data.matched, id: data.id });
      } catch {
        t.remove();
        add('bot', 'Sorry, something went wrong. Please try again or message us on WhatsApp.');
        lead.hidden = false;
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const message = input.value.trim();
      if (!message) return;
      input.value = '';
      ask(message);
    });
    root.querySelectorAll<HTMLButtonElement>('[data-chat-q]').forEach((b) => b.addEventListener('click', () => ask(b.dataset.chatQ!)));

    lead.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(lead);
      const btn = lead.querySelector('button')!;
      btn.disabled = true;
      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            lead: { name: fd.get('name'), contact: fd.get('contact') },
            history,
            page: location.href,
            attribution: getAttribution(),
            lang: document.documentElement.getAttribute('data-lang') || 'en',
          }),
        });
        const data = await res.json();
        lead.hidden = true;
        add('bot', esc(data.answer));
        (window as any).track?.('generate_lead', { source: 'chat' });
      } catch {
        add('bot', 'Could not send. Please message us on WhatsApp.');
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
