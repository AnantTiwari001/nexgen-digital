---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import T from './T.astro';
import Mountains from './Mountains.astro';
import { site, whatsappUrl } from '../config/site';
import { servicePages } from '../data/services';

const year = new Date().getFullYear();
const socials = [
  { name: 'facebook', href: site.social.facebook, label: 'Facebook' },
  { name: 'instagram', href: site.social.instagram, label: 'Instagram' },
  { name: 'tiktok', href: site.social.tiktok, label: 'TikTok' },
  { name: 'linkedin', href: site.social.linkedin, label: 'LinkedIn' },
  { name: 'youtube', href: site.social.youtube, label: 'YouTube' },
] as const;
---

<footer class="footer">
  <div class="footer__mountains" aria-hidden="true"><Mountains /></div>
  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo variant="stacked" height={64} />
      <p class="footer__tagline"><T k="footer.tagline" /></p>
      <p class="script footer__script">{site.phrases.footerLine}</p>
      <div class="footer__social">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="footer__social-link">
            <Icon name={s.name} size={20} />
          </a>
        ))}
      </div>
    </div>

    <div>
      <h4 class="footer__h"><T k="footer.services" /></h4>
      <ul class="footer__list">
        {servicePages.slice(0, 8).map((s) => (
          <li><a href={`/services/${s.slug}`}>{s.shortName ?? s.name}</a></li>
        ))}
        <li><a href="/products/ai-smart-reviews-qr">Smart Reviews QR</a></li>
      </ul>
    </div>

    <div>
      <h4 class="footer__h"><T k="footer.company" /></h4>
      <ul class="footer__list">
        <li><a href="/about"><T k="nav.about" /></a></li>
        <li><a href="/services"><T k="nav.services" /></a></li>
        {site.features.pricingPage && <li><a href="/pricing"><T k="nav.pricing" /></a></li>}
        <li><a href="/preorder"><T k="nav.preorder" /></a></li>
        <li><a href="/contact"><T k="nav.contact" /></a></li>
        <li><a href="/privacy"><T k="footer.privacy" /></a></li>
        <li><a href="/terms"><T k="footer.terms" /></a></li>
      </ul>
    </div>

    <div>
      <h4 class="footer__h"><T k="footer.contact" /></h4>
      <ul class="footer__list footer__list--contact">
        <li><Icon name="pin" size={18} /><span>{site.location.addressLine}</span></li>
        <li><Icon name="phone" size={18} /><a href={`tel:${site.contact.phone.replace(/\s/g, '')}`}>{site.contact.phone}</a></li>
        <li><Icon name="mail" size={18} /><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        <li><Icon name="clock" size={18} /><span><T k="contact.hoursValue" /></span></li>
      </ul>
      <a class="btn btn--whatsapp btn--sm" href={whatsappUrl()} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={18} />
        <T k="cta.whatsapp" />
      </a>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>&copy; {year} {site.legalName} <T k="footer.rights" /></p>
    <p class="footer__meta caps">{site.registrationNumber} · {site.pan}</p>
    <p class="caps"><Icon name="mountain" size={14} /> <T k="footer.made" /></p>
  </div>
  <div class="flag-strip" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--bg-inverse);
    color: var(--fg-inverse);
    padding-top: var(--space-9);
    overflow: hidden;
  }
  .footer__mountains {
    position: absolute;
    inset: auto 0 0 0;
    opacity: 0.08;
    pointer-events: none;
  }
  .footer__grid {
    position: relative;
    display: grid;
    gap: var(--space-7);
    grid-template-columns: 1fr;
    padding-bottom: var(--space-8);
  }
  @media (min-width: 720px) {
    .footer__grid { grid-template-columns: 1.4fr 1fr 1fr; }
    .footer__brand { grid-column: 1 / -1; }
  }
  @media (min-width: 1024px) {
    .footer__grid { grid-template-columns: 1.6fr 1fr 1fr 1.3fr; }
    .footer__brand { grid-column: auto; }
  }
  .footer :global(.logo) { --logo-word: var(--fg-inverse); }
  .footer__tagline {
    margin-top: var(--space-4);
    color: var(--fg-inverse);
    opacity: 0.7;
    max-width: 30ch;
  }
  .footer__script { margin-top: var(--space-2); }
  .footer__social {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }
  .footer__social-link {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    transition: background-color var(--dur-fast), color var(--dur-fast), transform var(--dur-fast);
  }
  .footer__social-link:hover {
    background: var(--brand-orange);
    border-color: var(--brand-orange);
    color: #fff;
    transform: translateY(-2px);
  }
  .footer__h {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    font-weight: 600;
    color: var(--brand-orange);
    margin-bottom: var(--space-4);
  }
  .footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }
  .footer__list a { opacity: 0.8; transition: opacity var(--dur-fast), color var(--dur-fast); }
  .footer__list a:hover { opacity: 1; color: var(--brand-orange); }
  .footer__list--contact li {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    opacity: 0.85;
  }
  .footer__list--contact svg { flex: none; margin-top: 3px; color: var(--brand-orange); }
  .footer__list--contact { margin-bottom: var(--space-5); }
  .footer__bottom {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    justify-content: space-between;
    align-items: center;
    padding-block: var(--space-5);
    border-top: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    font-size: var(--text-sm);
    opacity: 0.8;
  }
  .footer__bottom p { margin: 0; display: inline-flex; align-items: center; gap: 0.4em; }
</style>
